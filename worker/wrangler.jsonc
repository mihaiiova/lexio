{
  "name": "slove-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slove-analytics",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "PUBLIC_ENDPOINTS_ENABLED": "false" },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
